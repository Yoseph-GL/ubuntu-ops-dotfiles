#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"

MODE="dry-run"
WITH_VOLUMES=0

usage() {
  cat <<'USAGE'
Usage: docker-clean-safe [--run] [--with-volumes]

Safe Docker cleanup.
Default mode is dry-run (shows what would be removed).
Use --run to execute cleanup.

Actions:
- docker image prune -a (unused images)
- docker container prune (stopped containers)
- docker builder prune (build cache)
- docker network prune (unused networks)
- docker volume prune (only with --with-volumes)
USAGE
}

log_info() { printf '[INFO] %s\n' "$*"; }
log_err() { printf '[ERROR] %s\n' "$*" >&2; }
die() { log_err "$*"; exit 1; }

require_cmd() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 || die "Required command not found: $cmd"
}

reject_run_flag_typo() {
  local arg="$1"
  if [[ "$arg" != "--run" && "$arg" =~ ^[-/]+[Rr][Uu][Nn]$ ]]; then
    die "Invalid execution flag '$arg'. Use exactly --run."
  fi
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    reject_run_flag_typo "$1"
    case "$1" in
      --run)
        MODE="run"
        shift
        ;;
      --with-volumes)
        WITH_VOLUMES=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1"
        ;;
    esac
  done
}

print_plan() {
  echo "=== DOCKER CLEAN SAFE ==="
  echo "Script path: $SCRIPT_DIR"
  echo "Mode: $MODE"
  echo "With volumes: $WITH_VOLUMES"
  echo
}

execute_dry_run() {
  print_plan
  require_cmd docker
  docker system df
  echo
  echo "[DRY RUN]"
  echo "Would run:"
  echo "  docker image prune -a -f"
  echo "  docker container prune -f"
  echo "  docker builder prune -f"
  echo "  docker network prune -f"
  if [[ "$WITH_VOLUMES" -eq 1 ]]; then
    echo "  docker volume prune -f"
  fi
  echo
  echo "Dry-run only. Re-run with --run to execute."
}

execute_real() {
  print_plan
  require_cmd docker
  docker system df
  echo

  log_info "Cleaning Docker artifacts"
  docker image prune -a -f
  docker container prune -f
  docker builder prune -f
  docker network prune -f
  if [[ "$WITH_VOLUMES" -eq 1 ]]; then
    docker volume prune -f
  fi
  echo
  echo "[AFTER]"
  docker system df
}

main() {
  trap 'log_err "Failed at line $LINENO: $BASH_COMMAND"' ERR
  parse_args "$@"
  if [[ "$MODE" == "run" ]]; then
    execute_real
  else
    execute_dry_run
  fi
}

main "$@"
