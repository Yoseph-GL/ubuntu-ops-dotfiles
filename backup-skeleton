#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
SNAPSHOTS_DIR="$HOME/Backups/Snapshots"
CONFIG_DUMPS_DIR="$SNAPSHOTS_DIR/Config_Dumps"

DEST_BASE="$SNAPSHOTS_DIR"
SNAP_NAME="home-skeleton-$(date +%F_%H%M%S)"
MODE="dry-run"

usage() {
  cat <<'USAGE'
Usage: backup-skeleton [--run] [--dest DIR] [--name NAME]

Create a lightweight snapshot of HOME directory structure (directories only).
No files are copied.

Options:
  --run        Execute snapshot creation.
               Default behavior is dry-run.
  --dest DIR   Base destination directory.
               Allowed values:
               - $HOME/Backups/Snapshots
               - $HOME/Backups/Snapshots/Config_Dumps
               Default: $HOME/Backups/Snapshots
  --name NAME  Snapshot folder name.
               Default: home-skeleton-YYYY-MM-DD_HHMMSS
  -h, --help   Show this help.
USAGE
}

log_err() { printf '[ERROR] %s\n' "$*" >&2; }
die() { log_err "$*"; exit 1; }

require_cmd() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 || die "Required command not found: $cmd"
}

reject_run_flag_typo() {
  local arg="$1"
  if [[ "$arg" != "--run" && "$arg" =~ ^[-/]+[Rr][Uu][Nn]$ ]]; then
    die "Invalid execution flag '$arg'. Use exactly --run."
  fi
}

validate_dest_base() {
  local dest="${1%/}"
  case "$dest" in
    "$SNAPSHOTS_DIR"|"$CONFIG_DUMPS_DIR") ;;
    *)
      die "Invalid --dest: $1. Use $SNAPSHOTS_DIR or $CONFIG_DUMPS_DIR."
      ;;
  esac
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    reject_run_flag_typo "$1"
    case "$1" in
      --dest)
        DEST_BASE="${2:?Missing value for --dest}"
        shift 2
        ;;
      --run)
        MODE="run"
        shift
        ;;
      --name)
        SNAP_NAME="${2:?Missing value for --name}"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1"
        ;;
    esac
  done
}

execute_dry_run() {
  local dest_dir="$1"
  echo "=== BACKUP SKELETON ==="
  echo "Script path: $SCRIPT_DIR"
  echo "Mode: $MODE"
  echo "Source: $HOME/"
  echo "Destination: $dest_dir"
  echo
  echo "Would run:"
  echo "  rsync -a -f'+ */' -f'- *' [excludes...] \"$HOME/\" \"$dest_dir/\""
  echo
  echo "Dry-run only. Re-run with --run to execute."
}

execute_real() {
  local dest_dir="$1"
  require_cmd rsync
  mkdir -p "$DEST_BASE" "$dest_dir"

  rsync -a \
    -f'+ */' -f'- *' \
    --exclude='Backups/Snapshots/***' \
    --exclude='.cache/***' \
    --exclude='.local/share/Trash/***' \
    --exclude='.npm/***' \
    --exclude='.gradle/***' \
    "$HOME/" "$dest_dir/"

  echo "Skeleton snapshot created: $dest_dir"
}

main() {
  trap 'log_err "Failed at line $LINENO: $BASH_COMMAND"' ERR
  parse_args "$@"
  validate_dest_base "$DEST_BASE"

  local dest_dir="$DEST_BASE/$SNAP_NAME"
  if [[ "$MODE" == "run" ]]; then
    execute_real "$dest_dir"
  else
    execute_dry_run "$dest_dir"
  fi
}

main "$@"
