#!/usr/bin/env bash
set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/${SCRIPT_NAME}.lock"

usage() {
  cat <<'USAGE'
Usage: update-all [--run] [--backup-dir DIR]

Manual-safe updater for apt + snap + flatpak.
Default mode is dry-run (shows actions only).

Options:
  --run             Execute updates and write package snapshots.
  --backup-dir DIR  Directory to save package lists.
                    Default: $HOME/Backups/Snapshots/Config_Dumps
  -h, --help        Show this help.
USAGE
}

log_info() { printf '[INFO] %s\n' "$*"; }
log_warn() { printf '[WARN] %s\n' "$*" >&2; }
log_err() { printf '[ERROR] %s\n' "$*" >&2; }
die() { log_err "$*"; exit 1; }

require_cmd() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 || die "Required command not found: $cmd"
}

trap 'log_err "Failed at line $LINENO: $BASH_COMMAND"' ERR

MODE="dry-run"
BACKUP_DIR="$HOME/Backups/Snapshots/Config_Dumps"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --run)
      MODE="run"
      shift
      ;;
    --backup-dir)
      BACKUP_DIR="${2:?Missing value for --backup-dir}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "Unknown argument: $1"
      ;;
  esac
done

echo "=== UPDATE-ALL ==="
echo "Mode: $MODE"
echo "Backup dir: $BACKUP_DIR"
echo
echo "Would run:"
echo "  sudo apt-get update"
echo "  sudo apt-get full-upgrade -y"
echo "  sudo apt-get autoremove -y"
echo "  sudo apt-get autoclean -y"
echo "  apt list --upgradable > $BACKUP_DIR/apt_upgradable_before.txt"
echo "  apt list --upgradable > $BACKUP_DIR/apt_upgradable_after.txt"
if command -v flatpak >/dev/null 2>&1; then
  echo "  flatpak update -y"
fi
if command -v snap >/dev/null 2>&1; then
  echo "  snap refresh --list > $BACKUP_DIR/snap_pending_before.txt"
  echo "  sudo snap refresh"
  echo "  snap refresh --list > $BACKUP_DIR/snap_pending_after.txt"
fi
echo "  apt-mark showmanual | sort > $BACKUP_DIR/apt_list.txt"
if command -v flatpak >/dev/null 2>&1; then
  echo "  flatpak list --app --columns=application,name | sort > $BACKUP_DIR/flatpak_list.txt"
fi
if command -v snap >/dev/null 2>&1; then
  echo "  snap list | tail -n +2 | awk '{print \$1}' | sort > $BACKUP_DIR/snap_list.txt"
fi

if [[ "$MODE" != "run" ]]; then
  echo
  echo "Dry-run only. Re-run with --run to execute."
  exit 0
fi

require_cmd flock
require_cmd sudo
require_cmd apt-get
require_cmd apt-mark

mkdir -p "$BACKUP_DIR"

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  die "Another $SCRIPT_NAME process is already running."
fi

if ! sudo -v; then
  die "sudo authentication failed."
fi

log_info "Saving package snapshots (before update)"
if command -v apt >/dev/null 2>&1; then
  apt list --upgradable 2>/dev/null > "$BACKUP_DIR/apt_upgradable_before.txt" || true
else
  log_warn "apt command not found; skipping apt_upgradable_before snapshot"
fi

if command -v snap >/dev/null 2>&1; then
  snap refresh --list > "$BACKUP_DIR/snap_pending_before.txt" 2>/dev/null || true
fi

echo
echo "--- ACTUALIZANDO SISTEMA (APT) ---"
sudo apt-get update
sudo apt-get full-upgrade -y
sudo apt-get autoremove -y
sudo apt-get autoclean -y

if command -v snap >/dev/null 2>&1; then
  echo "--- ACTUALIZANDO APPS (SNAP) ---"
  sudo snap refresh
else
  echo "--- SNAP NO INSTALADO, OMITIENDO ---"
fi

if command -v flatpak >/dev/null 2>&1; then
  echo "--- ACTUALIZANDO APPS (FLATPAK) ---"
  flatpak update -y
else
  echo "--- FLATPAK NO INSTALADO, OMITIENDO ---"
fi

echo "--- GUARDANDO LISTAS DE PAQUETES ---"
apt-mark showmanual | sort > "$BACKUP_DIR/apt_list.txt"
if command -v apt >/dev/null 2>&1; then
  apt list --upgradable 2>/dev/null > "$BACKUP_DIR/apt_upgradable_after.txt" || true
fi
if command -v flatpak >/dev/null 2>&1; then
  flatpak list --app --columns=application,name | sort > "$BACKUP_DIR/flatpak_list.txt"
fi
if command -v snap >/dev/null 2>&1; then
  snap list | tail -n +2 | awk '{print $1}' | sort > "$BACKUP_DIR/snap_list.txt"
  snap refresh --list > "$BACKUP_DIR/snap_pending_after.txt" 2>/dev/null || true
fi

echo "--- TODO LISTO: Sistema actualizado y snapshots guardados en $BACKUP_DIR ---"
