#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
SCRIPT_NAME="$(basename "$0")"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/${SCRIPT_NAME}.lock"

SNAPSHOTS_DIR="$HOME/Backups/Snapshots"
CONFIG_DUMPS_DIR="$SNAPSHOTS_DIR/Config_Dumps"

MODE="dry-run"
DAYS=14
BACKUP_DIR="$CONFIG_DUMPS_DIR"
UPDATE_CMD="$SCRIPT_DIR/update-all"
CLEAN_CMD="$SCRIPT_DIR/../system/disk-clean-safe"

usage() {
  cat <<'USAGE'
Usage: maintenance-all [--run] [--days N] [--backup-dir DIR]

One-command maintenance wrapper:
1) update-all
2) disk-clean-safe --deep-system-clean

Default behavior is dry-run.

Options:
  --run             Execute both steps.
  --days N          Age threshold for disk-clean-safe (default: 14).
  --backup-dir DIR  Backup dir forwarded to update-all.
                    Allowed values:
                    - $HOME/Backups/Snapshots
                    - $HOME/Backups/Snapshots/Config_Dumps
                    Default: $HOME/Backups/Snapshots/Config_Dumps
  -h, --help        Show this help.
USAGE
}

log_info() { printf '[INFO] %s\n' "$*"; }
log_err() { printf '[ERROR] %s\n' "$*" >&2; }
die() { log_err "$*"; exit 1; }

require_cmd() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 || die "Required command not found: $cmd"
}

require_executable_file() {
  local file="$1"
  [[ -f "$file" ]] || die "Required file not found: $file"
  [[ -x "$file" ]] || die "Required file is not executable: $file"
}

reject_run_flag_typo() {
  local arg="$1"
  if [[ "$arg" != "--run" && "$arg" =~ ^[-/]+[Rr][Uu][Nn]$ ]]; then
    die "Invalid execution flag '$arg'. Use exactly --run."
  fi
}

validate_backup_dir() {
  local dir="${1%/}"
  case "$dir" in
    "$SNAPSHOTS_DIR"|"$CONFIG_DUMPS_DIR") ;;
    *)
      die "Invalid --backup-dir: $1. Use $SNAPSHOTS_DIR or $CONFIG_DUMPS_DIR."
      ;;
  esac
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    reject_run_flag_typo "$1"
    case "$1" in
      --run)
        MODE="run"
        shift
        ;;
      --days)
        DAYS="${2:?Missing value for --days}"
        [[ "$DAYS" =~ ^[0-9]+$ ]] || die "--days must be a non-negative integer"
        shift 2
        ;;
      --backup-dir)
        BACKUP_DIR="${2:?Missing value for --backup-dir}"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1"
        ;;
    esac
  done
}

check_dependencies() {
  require_executable_file "$UPDATE_CMD"
  require_executable_file "$CLEAN_CMD"
}

print_plan() {
  echo "=== MAINTENANCE ALL ==="
  echo "Mode: $MODE"
  echo "Script path: $SCRIPT_DIR"
  echo "Days: $DAYS"
  echo "Backup dir: $BACKUP_DIR"
  echo
  echo "Step 1: update-all"
  echo "Step 2: disk-clean-safe --deep-system-clean"
  echo
}

execute_dry_run() {
  print_plan
  log_info "Starting update-all (dry-run)..."
  "$UPDATE_CMD" --backup-dir "$BACKUP_DIR"
  log_info "Completed update-all (dry-run)."
  echo
  log_info "Starting disk-clean-safe (dry-run)..."
  "$CLEAN_CMD" --days "$DAYS" --deep-system-clean
  log_info "Completed disk-clean-safe (dry-run)."
  echo
  echo "Dry-run completed. Re-run with --run to execute all steps."
}

execute_real() {
  print_plan
  require_cmd flock
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    die "Another $SCRIPT_NAME process is already running (lock: $LOCK_FILE)."
  fi

  log_info "Starting update-all..."
  "$UPDATE_CMD" --run --backup-dir "$BACKUP_DIR"
  log_info "Completed update-all."
  echo
  log_info "Starting disk-clean-safe..."
  "$CLEAN_CMD" --run --days "$DAYS" --deep-system-clean
  log_info "Completed disk-clean-safe."
  echo
  echo "Maintenance completed."
}

main() {
  trap 'log_err "Failed at line $LINENO: $BASH_COMMAND"' ERR
  parse_args "$@"
  validate_backup_dir "$BACKUP_DIR"
  mkdir -p "$BACKUP_DIR"
  check_dependencies

  if [[ "$MODE" == "run" ]]; then
    execute_real
  else
    execute_dry_run
  fi
}

main "$@"
