#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
SCRIPT_NAME="$(basename "$0")"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/${SCRIPT_NAME}.lock"

SNAPSHOTS_DIR="$HOME/Backups/Snapshots"
CONFIG_DUMPS_DIR="$SNAPSHOTS_DIR/Config_Dumps"

MODE="dry-run"
BACKUP_DIR="$CONFIG_DUMPS_DIR"
APT_GET_COMMON_ARGS=(
  -y
  -qq
  -o DPkg::Lock::Timeout=10
  -o Dpkg::Options::="--force-confdef"
  -o Dpkg::Options::="--force-confold"
)

usage() {
  cat <<'USAGE'
Usage: update-all [--run] [--backup-dir DIR]

Manual-safe updater for apt + snap + flatpak.
Default mode is dry-run (shows actions only).

Options:
  --run             Execute updates and write package snapshots.
  --backup-dir DIR  Directory to save package lists.
                    Allowed values:
                    - $HOME/Backups/Snapshots
                    - $HOME/Backups/Snapshots/Config_Dumps
                    Default: $HOME/Backups/Snapshots/Config_Dumps
  -h, --help        Show this help.
USAGE
}

log_info() { printf '[INFO] %s\n' "$*"; }
log_warn() { printf '[WARN] %s\n' "$*" >&2; }
log_err() { printf '[ERROR] %s\n' "$*" >&2; }
die() { log_err "$*"; exit 1; }

require_cmd() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 || die "Required command not found: $cmd"
}

apt_get_noninteractive() {
  sudo -n DEBIAN_FRONTEND=noninteractive apt-get "${APT_GET_COMMON_ARGS[@]}" "$@"
}

reject_run_flag_typo() {
  local arg="$1"
  if [[ "$arg" != "--run" && "$arg" =~ ^[-/]+[Rr][Uu][Nn]$ ]]; then
    die "Invalid execution flag '$arg'. Use exactly --run."
  fi
}

validate_backup_dir() {
  local dir="${1%/}"
  case "$dir" in
    "$SNAPSHOTS_DIR"|"$CONFIG_DUMPS_DIR") ;;
    *)
      die "Invalid --backup-dir: $1. Use $SNAPSHOTS_DIR or $CONFIG_DUMPS_DIR."
      ;;
  esac
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    reject_run_flag_typo "$1"
    case "$1" in
      --run)
        MODE="run"
        shift
        ;;
      --backup-dir)
        BACKUP_DIR="${2:?Missing value for --backup-dir}"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1"
        ;;
    esac
  done
}

check_dependencies() {
  require_cmd flock
  require_cmd sudo
  require_cmd apt-get
  require_cmd apt-mark
  require_cmd sort
}

print_plan() {
  echo "=== UPDATE-ALL ==="
  echo "Script path: $SCRIPT_DIR"
  echo "Mode: $MODE"
  echo "Backup dir: $BACKUP_DIR"
  echo
  echo "Would run:"
  echo "  sudo -n DEBIAN_FRONTEND=noninteractive apt-get -y -qq -o DPkg::Lock::Timeout=10 -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\" update"
  echo "  sudo -n DEBIAN_FRONTEND=noninteractive apt-get -y -qq -o DPkg::Lock::Timeout=10 -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\" full-upgrade"
  echo "  sudo -n DEBIAN_FRONTEND=noninteractive apt-get -y -qq -o DPkg::Lock::Timeout=10 -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\" autoremove"
  echo "  sudo -n DEBIAN_FRONTEND=noninteractive apt-get -y -qq -o DPkg::Lock::Timeout=10 -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\" autoclean"
  echo "  apt list --upgradable > $BACKUP_DIR/apt_upgradable_before.txt"
  echo "  apt list --upgradable > $BACKUP_DIR/apt_upgradable_after.txt"
  if command -v flatpak >/dev/null 2>&1; then
    echo "  flatpak update -y --noninteractive"
  fi
  if command -v snap >/dev/null 2>&1; then
    echo "  snap refresh --list > $BACKUP_DIR/snap_pending_before.txt"
    echo "  sudo -n snap refresh"
    echo "  snap refresh --list > $BACKUP_DIR/snap_pending_after.txt"
  fi
  echo "  apt-mark showmanual | sort > $BACKUP_DIR/apt_list.txt"
  if command -v flatpak >/dev/null 2>&1; then
    echo "  flatpak list --app --columns=application,name | sort > $BACKUP_DIR/flatpak_list.txt"
  fi
  if command -v snap >/dev/null 2>&1; then
    echo "  snap list | tail -n +2 | awk '{print \$1}' | sort > $BACKUP_DIR/snap_list.txt"
  fi
}

save_snapshot_if_possible() {
  local cmd_desc="$1"
  local output_file="$2"
  shift 2
  if ! "$@" > "$output_file" 2>/dev/null; then
    log_warn "Could not write snapshot for $cmd_desc -> $output_file"
  fi
}

execute_dry_run() {
  print_plan
  echo
  echo "Dry-run only. Re-run with --run to execute."
}

execute_real() {
  check_dependencies
  mkdir -p "$BACKUP_DIR"

  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    die "Another $SCRIPT_NAME process is already running (lock: $LOCK_FILE)."
  fi

  sudo -n -v || die "sudo credentials unavailable in non-interactive mode."

  log_info "Saving package snapshots (before update)"
  if command -v apt >/dev/null 2>&1; then
    save_snapshot_if_possible "apt upgradable before" \
      "$BACKUP_DIR/apt_upgradable_before.txt" \
      apt list --upgradable
  else
    log_warn "apt command not found; skipping apt_upgradable_before snapshot"
  fi

  if command -v snap >/dev/null 2>&1; then
    save_snapshot_if_possible "snap pending before" \
      "$BACKUP_DIR/snap_pending_before.txt" \
      snap refresh --list
  fi

  echo
  echo "--- UPDATING SYSTEM (APT) ---"
  apt_get_noninteractive update
  apt_get_noninteractive full-upgrade
  apt_get_noninteractive autoremove
  apt_get_noninteractive autoclean

  if command -v snap >/dev/null 2>&1; then
    echo "--- UPDATING APPS (SNAP) ---"
    sudo -n snap refresh
  else
    echo "--- SNAP NOT INSTALLED, SKIPPING ---"
  fi

  if command -v flatpak >/dev/null 2>&1; then
    echo "--- UPDATING APPS (FLATPAK) ---"
    flatpak update -y --noninteractive
  else
    echo "--- FLATPAK NOT INSTALLED, SKIPPING ---"
  fi

  echo "--- SAVING PACKAGE LISTS ---"
  apt-mark showmanual | sort > "$BACKUP_DIR/apt_list.txt"
  if command -v apt >/dev/null 2>&1; then
    save_snapshot_if_possible "apt upgradable after" \
      "$BACKUP_DIR/apt_upgradable_after.txt" \
      apt list --upgradable
  fi
  if command -v flatpak >/dev/null 2>&1; then
    flatpak list --app --columns=application,name | sort > "$BACKUP_DIR/flatpak_list.txt"
  fi
  if command -v snap >/dev/null 2>&1; then
    snap list | tail -n +2 | awk '{print $1}' | sort > "$BACKUP_DIR/snap_list.txt"
    save_snapshot_if_possible "snap pending after" \
      "$BACKUP_DIR/snap_pending_after.txt" \
      snap refresh --list
  fi

  echo "--- DONE: System updated and snapshots saved in $BACKUP_DIR ---"
}

main() {
  trap 'log_err "Failed at line $LINENO: $BASH_COMMAND"' ERR
  parse_args "$@"
  validate_backup_dir "$BACKUP_DIR"
  mkdir -p "$BACKUP_DIR"

  if [[ "$MODE" == "run" ]]; then
    execute_real
  else
    execute_dry_run
  fi
}

main "$@"
