#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
SNAPSHOTS_DIR="$HOME/Backups/Snapshots"
CONFIG_DUMPS_DIR="$SNAPSHOTS_DIR/Config_Dumps"

MODE="dry-run"
DEST_BASE="$CONFIG_DUMPS_DIR"
BACKUP_NAME="config-backup-$(date +%F_%H%M%S)"

CONFIG_FILES=(
  "$HOME/.zshrc"
  "$HOME/.config/alacritty/alacritty.toml"
  "$HOME/.config/fastfetch/config.jsonc"
)

usage() {
  cat <<'USAGE'
Usage: backup-configs [--run] [--dest DIR] [--name NAME]

Back up key local configuration files and Ops scripts into a timestamped folder.
Default behavior is dry-run.

Options:
  --run        Execute backup.
  --dest DIR   Base destination directory.
               Allowed values:
               - $HOME/Backups/Snapshots
               - $HOME/Backups/Snapshots/Config_Dumps
               Default: $HOME/Backups/Snapshots/Config_Dumps
  --name NAME  Backup folder name.
               Default: config-backup-YYYY-MM-DD_HHMMSS
  -h, --help   Show this help.
USAGE
}

log_err() { printf '[ERROR] %s\n' "$*" >&2; }
log_warn() { printf '[WARN] %s\n' "$*" >&2; }
die() { log_err "$*"; exit 1; }

require_cmd() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 || die "Required command not found: $cmd"
}

reject_run_flag_typo() {
  local arg="$1"
  if [[ "$arg" != "--run" && "$arg" =~ ^[-/]+[Rr][Uu][Nn]$ ]]; then
    die "Invalid execution flag '$arg'. Use exactly --run."
  fi
}

validate_dest_base() {
  local dest="${1%/}"
  case "$dest" in
    "$SNAPSHOTS_DIR"|"$CONFIG_DUMPS_DIR") ;;
    *)
      die "Invalid --dest: $1. Use $SNAPSHOTS_DIR or $CONFIG_DUMPS_DIR."
      ;;
  esac
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    reject_run_flag_typo "$1"
    case "$1" in
      --run)
        MODE="run"
        shift
        ;;
      --dest)
        DEST_BASE="${2:?Missing value for --dest}"
        shift 2
        ;;
      --name)
        BACKUP_NAME="${2:?Missing value for --name}"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1"
        ;;
    esac
  done
}

check_dependencies() {
  require_cmd cp
  require_cmd find
  require_cmd sort
  require_cmd xargs
  require_cmd sha256sum
  require_cmd hostname
}

print_plan() {
  local dest_dir="$1"
  echo "=== BACKUP CONFIGS ==="
  echo "Mode: $MODE"
  echo "Destination: $dest_dir"
  echo
  echo "Will include files:"
  local f
  for f in "${CONFIG_FILES[@]}"; do
    echo "  - $f"
  done
  echo "Will include directory:"
  echo "  - $SCRIPT_DIR"
}

execute_dry_run() {
  local dest_dir="$1"
  print_plan "$dest_dir"
  echo
  echo "Dry-run only. Re-run with --run to execute."
}

execute_real() {
  local dest_dir="$1"
  local files_dir="$dest_dir/files"
  local rel_path target f

  check_dependencies
  mkdir -p "$DEST_BASE" "$files_dir"

  for f in "${CONFIG_FILES[@]}"; do
    if [[ -f "$f" ]]; then
      rel_path="${f#"$HOME"/}"
      target="$files_dir/$rel_path"
      mkdir -p "$(dirname "$target")"
      cp -a "$f" "$target"
    else
      log_warn "Missing file, skipped: $f"
    fi
  done

  cp -a "$SCRIPT_DIR" "$dest_dir/ops-scripts"

  (
    cd "$dest_dir"
    find . -type f ! -name 'SHA256SUMS.txt' -print0 \
      | sort -z \
      | xargs -0 --no-run-if-empty sha256sum > SHA256SUMS.txt
  )

  cat > "$dest_dir/README.txt" <<INFO
Backup Created: $(date '+%F %T %Z')
Host: $(hostname)
Path: $dest_dir

Contents:
- files/: selected config files preserving relative path from HOME
- ops-scripts/: snapshot of Ops scripts directory
- SHA256SUMS.txt: integrity hashes of all files in this backup
INFO

  echo
  echo "Backup completed: $dest_dir"
}

main() {
  trap 'log_err "Failed at line $LINENO: $BASH_COMMAND"' ERR
  parse_args "$@"
  validate_dest_base "$DEST_BASE"

  local dest_dir="$DEST_BASE/$BACKUP_NAME"
  if [[ "$MODE" == "run" ]]; then
    execute_real "$dest_dir"
  else
    execute_dry_run "$dest_dir"
  fi
}

main "$@"
