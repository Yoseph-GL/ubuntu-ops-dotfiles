#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"

MODE="dry-run"
DAYS=14
DEEP_SYSTEM_CLEAN=0
APT_GET_COMMON_ARGS=(
  -y
  -qq
  -o DPkg::Lock::Timeout=10
  -o Dpkg::Options::="--force-confdef"
  -o Dpkg::Options::="--force-confold"
)

TRASH_DIR="$HOME/.local/share/Trash/files"
THUMBS_DIR="$HOME/.cache/thumbnails"
CACHE_DIR="$HOME/.cache"

KEEP_CACHE_PATTERNS=(
  "$CACHE_DIR/google-chrome"
  "$CACHE_DIR/mozilla"
  "$CACHE_DIR/JetBrains"
  "$CACHE_DIR/pip"
  "$CACHE_DIR/nvim"
)

usage() {
  cat <<'USAGE'
Usage: disk-clean-safe [--run] [--days N] [--deep-system-clean]

Safe disk cleanup for user-space reclaimable files.
Default mode is dry-run (preview only).

What it targets:
- Trash files in ~/.local/share/Trash/files
- Thumbnail cache in ~/.cache/thumbnails
- Old user temp files in /tmp older than N days
- Old cache files in ~/.cache older than N days (excluding critical app state dirs)

Options:
  --run               Execute cleanup.
  --days N            Age threshold in days for old temp/cache files.
                      Default: 14
  --deep-system-clean Include optional system cleanup:
                      - apt autoremove/autoclean/clean
                      - snap old revisions removal
                      - flatpak unused runtimes removal
                      - journal vacuum (14d)
  -h, --help          Show this help.
USAGE
}

log_info() { printf '[INFO] %s\n' "$*"; }
log_warn() { printf '[WARN] %s\n' "$*" >&2; }
log_err() { printf '[ERROR] %s\n' "$*" >&2; }
die() { log_err "$*"; exit 1; }

require_cmd() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 || die "Required command not found: $cmd"
}

apt_get_noninteractive() {
  sudo -n DEBIAN_FRONTEND=noninteractive apt-get "${APT_GET_COMMON_ARGS[@]}" "$@"
}

reject_run_flag_typo() {
  local arg="$1"
  if [[ "$arg" != "--run" && "$arg" =~ ^[-/]+[Rr][Uu][Nn]$ ]]; then
    die "Invalid execution flag '$arg'. Use exactly --run."
  fi
}

is_protected_cache_path() {
  local path="$1"
  local keep
  for keep in "${KEEP_CACHE_PATTERNS[@]}"; do
    if [[ "$path" == "$keep" || "$path" == "$keep"/* ]]; then
      return 0
    fi
  done
  return 1
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    reject_run_flag_typo "$1"
    case "$1" in
      --run)
        MODE="run"
        shift
        ;;
      --days)
        DAYS="${2:?Missing value for --days}"
        [[ "$DAYS" =~ ^[0-9]+$ ]] || die "--days must be a non-negative integer"
        shift 2
        ;;
      --deep-system-clean)
        DEEP_SYSTEM_CLEAN=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1"
        ;;
    esac
  done
}

check_dependencies() {
  require_cmd find
  require_cmd df
  require_cmd du
  require_cmd awk
  require_cmd sed
}

check_deep_dependencies() {
  require_cmd sudo
  require_cmd apt-get
  require_cmd journalctl
}

collect_counts() {
  local tmp_count=0
  local cache_count=0
  local trash_size_value="not present"
  local thumbs_size_value="not present"
  local file d

  if [[ -d "$TRASH_DIR" ]]; then
    trash_size_value="$(du -sh "$TRASH_DIR" | awk '{print $1}')"
  fi
  if [[ -d "$THUMBS_DIR" ]]; then
    thumbs_size_value="$(du -sh "$THUMBS_DIR" | awk '{print $1}')"
  fi

  while IFS= read -r file; do
    [[ -n "$file" ]] && tmp_count=$((tmp_count + 1))
  done < <(find /tmp -xdev -user "$USER" -mtime +"$DAYS" -type f 2>/dev/null)

  if [[ -d "$CACHE_DIR" ]]; then
    while IFS= read -r -d '' d; do
      if ! is_protected_cache_path "$d"; then
        cache_count=$((cache_count + 1))
      fi
    done < <(find "$CACHE_DIR" -xdev -mtime +"$DAYS" -type f -print0 2>/dev/null)
  fi

  printf '%s\t%s\t%s\t%s\n' "$tmp_count" "$cache_count" "$trash_size_value" "$thumbs_size_value"
}

print_header() {
  echo "=== DISK CLEAN SAFE ==="
  echo "Script path: $SCRIPT_DIR"
  echo "Mode: $MODE"
  echo "Age threshold: $DAYS days"
  echo "Deep system clean: $DEEP_SYSTEM_CLEAN"
  echo
  echo "[BEFORE]"
  df -h / | sed -n '1,2p'
  echo
  echo "Targets:"
  echo "  - $TRASH_DIR"
  echo "  - $THUMBS_DIR"
  echo "  - /tmp (user-owned files older than $DAYS days)"
  echo "  - $CACHE_DIR (files older than $DAYS days, with protected subdirs)"
  if [[ "$DEEP_SYSTEM_CLEAN" -eq 1 ]]; then
    echo "  - System cleanup (apt/snap/flatpak/journal)"
  fi
}

execute_dry_run() {
  local tmp_count cache_count trash_size thumbs_size
  read -r tmp_count cache_count trash_size thumbs_size < <(collect_counts)

  print_header
  echo
  echo "[DRY RUN] Estimated candidates:"
  echo "  Trash size: $trash_size"
  echo "  Thumbnails size: $thumbs_size"
  echo "  /tmp old files: $tmp_count"
  echo "  ~/.cache old files (after protected filter): $cache_count"
  if [[ "$DEEP_SYSTEM_CLEAN" -eq 1 ]]; then
    echo "  [deep-system-clean planned]"
    echo "    - sudo -n DEBIAN_FRONTEND=noninteractive apt-get -y -qq -o DPkg::Lock::Timeout=10 -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\" autoremove"
    echo "    - sudo -n DEBIAN_FRONTEND=noninteractive apt-get -y -qq -o DPkg::Lock::Timeout=10 -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\" autoclean"
    echo "    - sudo -n DEBIAN_FRONTEND=noninteractive apt-get -y -qq -o DPkg::Lock::Timeout=10 -o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\" clean"
    echo "    - snap: remove disabled revisions"
    echo "    - flatpak uninstall --unused -y --noninteractive"
    echo "    - sudo -n journalctl --vacuum-time=14d"
  fi
  echo
  echo "Dry-run only. Re-run with --run to execute."
}

run_deep_cleanup() {
  check_deep_dependencies
  sudo -n -v || die "sudo credentials unavailable in non-interactive mode."

  echo
  echo "[SYSTEM CLEANUP]"
  log_info "Running APT autoremove..."
  apt_get_noninteractive autoremove
  log_info "Completed APT autoremove."
  log_info "Running APT autoclean..."
  apt_get_noninteractive autoclean
  log_info "Completed APT autoclean."
  log_info "Running APT clean..."
  apt_get_noninteractive clean
  log_info "Completed APT clean."

  if command -v snap >/dev/null 2>&1; then
    log_info "Running Snap disabled revision cleanup..."
    local name rev
    while IFS= read -r line; do
      name="$(awk '{print $1}' <<<"$line")"
      rev="$(awk '{print $3}' <<<"$line")"
      if [[ -n "$name" && -n "$rev" ]]; then
        if ! sudo -n snap remove "$name" --revision="$rev"; then
          log_warn "Could not remove disabled snap revision $name/$rev"
        fi
      fi
    done < <(snap list --all 2>/dev/null | awk '/disabled/{print}')
    log_info "Completed Snap disabled revision cleanup."
  fi

  if command -v flatpak >/dev/null 2>&1; then
    log_info "Running Flatpak unused runtime cleanup..."
    if ! flatpak uninstall --unused -y --noninteractive; then
      log_warn "flatpak uninstall --unused returned a non-zero status"
    fi
    log_info "Completed Flatpak unused runtime cleanup."
  fi

  log_info "Running journal vacuum (14d)..."
  sudo -n journalctl --vacuum-time=14d
  log_info "Completed journal vacuum (14d)."
}

execute_real() {
  check_dependencies
  print_header

  if [[ -d "$TRASH_DIR" ]]; then
    find "$TRASH_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf {} + || true
  fi

  if [[ -d "$THUMBS_DIR" ]]; then
    find "$THUMBS_DIR" -mindepth 1 -maxdepth 3 -type f -delete || true
  fi

  find /tmp -xdev -user "$USER" -mtime +"$DAYS" -type f -delete 2>/dev/null || true
  find /tmp -xdev -user "$USER" -mtime +"$DAYS" -type d -empty -delete 2>/dev/null || true

  if [[ -d "$CACHE_DIR" ]]; then
    local file d
    while IFS= read -r -d '' file; do
      if ! is_protected_cache_path "$file"; then
        rm -f "$file"
      fi
    done < <(find "$CACHE_DIR" -xdev -mtime +"$DAYS" -type f -print0 2>/dev/null)

    while IFS= read -r -d '' d; do
      if ! is_protected_cache_path "$d"; then
        rmdir "$d" 2>/dev/null || log_warn "Could not remove directory: $d"
      fi
    done < <(find "$CACHE_DIR" -depth -type d -empty -print0 2>/dev/null)
  fi

  if [[ "$DEEP_SYSTEM_CLEAN" -eq 1 ]]; then
    run_deep_cleanup
  fi

  echo
  echo "[AFTER]"
  df -h / | sed -n '1,2p'
  log_info "Done."
}

main() {
  trap 'log_err "Failed at line $LINENO: $BASH_COMMAND"' ERR
  parse_args "$@"
  if [[ "$MODE" == "run" ]]; then
    execute_real
  else
    execute_dry_run
  fi
}

main "$@"
